@model ValidareViewModel
@{
    ViewData["Title"] = "Validare abonamente";
    var nume = User.FindFirst("nume_complet")?.Value;
}

<div class="container">
    <h1>Validare abonamente</h1>
    <p class="subtitle">Controlor: @(nume)</p>

    <div class="check-box">
        <form asp-controller="Validare" asp-action="Verifica" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="msg-err"></div>

            <label asp-for="Cod">Codul abonamentului</label>
            <input asp-for="Cod" type="text" autocomplete="off" placeholder="TA-XXXXXXXX" autofocus>
            <button type="submit" class="btn">Verifică</button>
        </form>

        @if (Model.RezultatCurent is not null)
        {
            var r = Model.RezultatCurent;
            <div class="result @(r.EsteValid ? "ok" : "bad")" role="status" aria-live="polite">
                <strong>@r.TitluAfisat</strong>
                <span>@r.Detalii</span>
            </div>
        }
    </div>

    <div class="panel">
        <h2>Validările de azi</h2>
        @if (Model.ValidariAzi.Count == 0)
        {
            <p class="muted">Nu există validări efectuate astăzi.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                    <tr>
                        <th>Ora</th>
                        <th>Cod</th>
                        <th>Rezultat</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.ValidariAzi)
                    {
                        <tr>
                            <td>@item.DataOra.ToLocalTime().ToString("HH:mm:ss")</td>
                            <td>@item.CodIntrodus</td>
                            <td><span class="badge @item.ClasaBadge">@item.EtichetaRezultat</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
