@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Administrare";
}

<div class="container">
    <h1>Administrare</h1>
    <p class="subtitle">Panou central pentru indicatori, catalog, conturi, jurnal de evenimente și rapoarte.</p>

    <div class="kpi-grid">
        <div class="kpi">
            <span class="kpi-value">@Model.AbonamenteActive</span>
            <span class="kpi-label">Abonamente active</span>
        </div>
        <div class="kpi">
            <span class="kpi-value">@Model.ComenziUltimaSaptamana</span>
            <span class="kpi-label">Comenzi în ultima săptămână</span>
        </div>
        <div class="kpi">
            <span class="kpi-value">@Model.ValidariAzi</span>
            <span class="kpi-label">Validări azi</span>
        </div>
        <div class="kpi">
            <span class="kpi-value">@Model.NumarConturi</span>
            <span class="kpi-label">Conturi</span>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Tipuri de abonament și tarife</h2>
            <button type="button" class="btn" disabled>Adaugă tip de abonament</button>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>Categorie</th>
                    @foreach (var p in AbonamenteData.Perioade.Values)
                    {
                        <th class="pret">@p</th>
                    }
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var c in AbonamenteData.Categorii)
                {
                    <tr>
                        <td>@c.Nume</td>
                        @if (c.EsteGratuit)
                        {
                            <td class="pret" colspan="@AbonamenteData.Perioade.Count">Gratuit</td>
                        }
                        else
                        {
                            @foreach (var luni in AbonamenteData.Perioade.Keys)
                            {
                                <td class="pret">@(AbonamenteData.FormateazaPret(c.Preturi![luni])) lei</td>
                            }
                        }
                        <td class="actions">
                            <button type="button" class="btn btn-sm" disabled>Modifică</button>
                            <button type="button" class="btn btn-sm btn-danger" disabled>Dezactivează</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Conturi și roluri</h2>
            <a asp-controller="AdminUtilizatori" asp-action="Index" class="btn">Gestionează conturile</a>
        </div>
        <p class="muted">Creează conturi de controlor, caută utilizatori și activează sau dezactivează conturile în pagina dedicată.</p>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Jurnal de evenimente</h2>
            <a asp-controller="AdminJurnal" asp-action="Index" class="btn">Deschide jurnalul</a>
        </div>
        <p class="muted">Consultă istoricul de audit al aplicației (autentificări, creări de conturi, comenzi, validări și anulări), filtrabil după utilizator, acțiune și perioadă.</p>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Rapoarte</h2>
            <a asp-controller="AdminRapoarte" asp-action="Index" class="btn">Generează și exportă rapoarte</a>
        </div>
        <p class="muted">Generează rapoarte pe perioadă pentru abonamentele emise (pe categorie și durată) și pentru validările efectuate, cu export în format CSV (UTF-8).</p>
    </div>
</div>
