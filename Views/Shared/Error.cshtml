@model ErrorViewModel
@{
    ViewData["Title"] = "Eroare";
}

<div class="container">
    <h1>A apărut o eroare</h1>
    <p>Cererea nu a putut fi procesată. Încearcă din nou sau revino la <a asp-controller="Home" asp-action="Index">pagina principală</a>.</p>

    @if (Model.ShowRequestId)
    {
        <p><strong>ID cerere:</strong> <code>@Model.RequestId</code></p>
    }
</div>
