@{
    var autentificat = User.Identity?.IsAuthenticated == true;
    var esteAdmin = User.IsInRole(AppRoles.Administrator);
    var esteControlor = User.IsInRole(AppRoles.Controlor);
    var esteClient = User.IsInRole(AppRoles.Client);
    var rol = esteAdmin ? AppRoles.Administrator : esteControlor ? AppRoles.Controlor : esteClient ? AppRoles.Client : "";
}
<header class="site-header">
    <div class="list-header">
        <div class="dropdown-button nav-item">
            <button type="button" class="icon-btn" aria-haspopup="true" aria-label="Meniul principal">
                <img src="~/images/dropdown.png" alt="" aria-hidden="true">
            </button>
            <div class="dropdown-content" role="navigation" aria-label="Meniul principal">
                <a asp-controller="Home" asp-action="Index">Acasă</a>
                <a asp-controller="Home" asp-action="About">Despre</a>
                <a asp-controller="Abonamente" asp-action="Index">Abonamente</a>
                <a asp-controller="Feedback" asp-action="Index">Feedback</a>
                <a asp-controller="Home" asp-action="Contact">Contact</a>
                @if (esteAdmin)
                {
                    <a asp-controller="Dashboard" asp-action="Admin">Administrare</a>
                }
                else if (esteControlor)
                {
                    <a asp-controller="Dashboard" asp-action="Controlor">Validare</a>
                }
                else if (esteClient)
                {
                    <a asp-controller="Dashboard" asp-action="Client">Contul meu</a>
                    <a asp-controller="Profil" asp-action="Index">Profilul meu</a>
                }
            </div>
        </div>

        <a class="brand" asp-controller="Home" asp-action="Index">TransAbon</a>

        <div class="login-button nav-item">
            @if (autentificat)
            {
                <div class="nav-user">
                    <span>@User.FindFirst("nume_complet")?.Value</span>
                    <span class="role-badge">@rol</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit">Deconectare</button>
                    </form>
                </div>
            }
            else
            {
                <a class="icon-btn" asp-controller="Account" asp-action="Login">
                    <img src="~/images/loggin.png" alt="Autentificare">
                </a>
            }
        </div>
    </div>
</header>
