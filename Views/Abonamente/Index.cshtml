@model AbonamenteViewModel
@{
    ViewData["Title"] = "Abonamente";
}

<div class="container">
    <h1>Abonamente</h1>
    <p class="subtitle">Prețurile sunt exprimate în lei (MDL). Abonamentele sunt valabile pe toate mijloacele de transport din regiune.</p>

    @if (Model.Categorii.Count == 0)
    {
        <p class="muted">Momentan nu există abonamente disponibile.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="tabel-tarife">
                <tr>
                    <th>Categorie</th>
                    @foreach (var luni in Model.Durate)
                    {
                        <th class="pret">@Tarife.EticheteDurata(luni)</th>
                    }
                </tr>
                @foreach (var categorie in Model.Categorii)
                {
                    if (categorie.Tipuri.All(t => t.EsteGratuit) && categorie.Tipuri.Count == Model.Durate.Count)
                    {
                        <tr class="gratuit">
                            <td>@categorie.Nume</td>
                            <td class="pret" colspan="@Model.Durate.Count">Gratuit</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@categorie.Nume</td>
                            @foreach (var luni in Model.Durate)
                            {
                                var tip = categorie.Tipuri.FirstOrDefault(t => t.DurataLuni == luni);
                                <td class="pret">@(tip is null ? "–" : tip.EsteGratuit ? "Gratuit" : $"{Tarife.FormateazaPret(tip.Pret)} lei")</td>
                            }
                        </tr>
                    }
                }
            </table>
        </div>
    }
</div>
