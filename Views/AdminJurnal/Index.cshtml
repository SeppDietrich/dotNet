@model AdminJurnalViewModel
@{
    ViewData["Title"] = "Jurnal de evenimente";
}

<div class="container">
    <div class="panel-head">
        <div>
            <h1>Jurnal de evenimente</h1>
            <p class="subtitle">Auditul acțiunilor din sistem (@Model.TotalEvenimente evenimente găsite).</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Admin" class="btn">Înapoi la panou</a>
    </div>

    <div class="panel">
        <form asp-controller="AdminJurnal" asp-action="Index" method="get" class="inline-form">
            <div class="form-group">
                <label for="filtru-utilizator">Utilizator / Obiect</label>
                <input id="filtru-utilizator" type="text" name="utilizator" value="@Model.Utilizator" placeholder="E-mail, nume sau cod..." />
            </div>

            <div class="form-group">
                <label for="filtru-actiune">Acțiune</label>
                <select id="filtru-actiune" name="actiune">
                    <option value="">Toate acțiunile</option>
                    @foreach (var act in Model.ActiuniDisponibile)
                    {
                        <option value="@act" selected="@(Model.Actiune == act)">@act</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="filtru-dela">De la data</label>
                <input id="filtru-dela" type="date" name="deLa" value="@(Model.DeLa?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="form-group">
                <label for="filtru-panala">Până la data</label>
                <input id="filtru-panala" type="date" name="panaLa" value="@(Model.PanaLa?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="form-group">
                <button type="submit" class="btn">Filtrează</button>
                <a asp-controller="AdminJurnal" asp-action="Index" class="btn">Resetează</a>
            </div>
        </form>
    </div>

    <div class="panel">
        @if (Model.Evenimente.Count == 0)
        {
            <p class="muted">Nu există evenimente înregistrate pentru filtrele selectate.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                    <tr>
                        <th>Data și ora</th>
                        <th>Utilizator</th>
                        <th>Acțiune</th>
                        <th>Obiect</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var ev in Model.Evenimente)
                    {
                        <tr>
                            <td>@ev.DataOra.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@ev.UtilizatorAfisat</td>
                            <td>@ev.Actiune</td>
                            <td>@ev.Obiect</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPagini > 1)
            {
                <div class="filters" style="margin-top: 16px; align-items: center;">
                    @if (Model.PaginaCurenta > 1)
                    {
                        <a asp-controller="AdminJurnal"
                           asp-action="Index"
                           asp-route-utilizator="@Model.Utilizator"
                           asp-route-actiune="@Model.Actiune"
                           asp-route-deLa="@(Model.DeLa?.ToString("yyyy-MM-dd"))"
                           asp-route-panaLa="@(Model.PanaLa?.ToString("yyyy-MM-dd"))"
                           asp-route-pagina="@(Model.PaginaCurenta - 1)"
                           class="btn btn-sm">« Pagina anterioară</a>
                    }

                    <span class="muted">Pagina @Model.PaginaCurenta din @Model.TotalPagini</span>

                    @if (Model.PaginaCurenta < Model.TotalPagini)
                    {
                        <a asp-controller="AdminJurnal"
                           asp-action="Index"
                           asp-route-utilizator="@Model.Utilizator"
                           asp-route-actiune="@Model.Actiune"
                           asp-route-deLa="@(Model.DeLa?.ToString("yyyy-MM-dd"))"
                           asp-route-panaLa="@(Model.PanaLa?.ToString("yyyy-MM-dd"))"
                           asp-route-pagina="@(Model.PaginaCurenta + 1)"
                           class="btn btn-sm">Pagina următoare »</a>
                    }
                </div>
            }
        }
    </div>
</div>
