@model RegisterViewModel
@{
    ViewData["Title"] = "Creare cont";
}

<div class="login-container">
    <h2>Creare cont</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="msg-err" role="alert">
            <ul>
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@e.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-controller="Account" asp-action="Register" method="post" novalidate>
        <div class="form-group">
            <label for="Nume">Nume</label>
            <input asp-for="Nume" type="text" autocomplete="family-name">
        </div>

        <div class="form-group">
            <label for="Prenume">Prenume</label>
            <input asp-for="Prenume" type="text" autocomplete="given-name">
        </div>

        <div class="form-group">
            <label for="Email">E-mail</label>
            <input asp-for="Email" type="email" autocomplete="email">
        </div>

        <div class="form-group">
            <label for="Password">Parolă (minim 8 caractere, literă mare, literă mică, cifră)</label>
            <input asp-for="Password" type="password" autocomplete="new-password">
        </div>

        <div class="form-group">
            <label for="ConfirmPassword">Confirmă parola</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password">
        </div>

        <button type="submit">Creează cont</button>
    </form>

    <p class="form-link">Ai deja cont? <a asp-controller="Account" asp-action="Login">Autentifică-te</a></p>
</div>
