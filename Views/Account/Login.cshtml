@model LoginViewModel
@{
    ViewData["Title"] = "Autentificare";
}

<!--LOGIN CONTENT-->
<div class="login-container">
    <h2>Autentificare</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="msg-err" role="alert">
            <ul>
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@e.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-controller="Account" asp-action="Login" method="post" novalidate>
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]">

        <div class="form-group">
            <label for="Email">E-mail</label>
            <input asp-for="Email" type="email" autocomplete="username">
        </div>

        <div class="form-group">
            <label for="Password">Parolă</label>
            <input asp-for="Password" type="password" autocomplete="current-password">
        </div>

        <button type="submit">Autentificare</button>
    </form>

    <p class="form-link">Nu ai cont? <a asp-controller="Account" asp-action="Register">Creează cont</a></p>
</div>
